    <!-- Home screen tutorial: one card per supported camera (camera/SupportedCamera.kt), the model's own
         menu path first, then these shared steps. -->
    <string name="home_tutorial_title">%1$s: turn on the camera\'s Wi-Fi</string>
    <string name="home_tutorial_step_ssid">The camera shows an SSID (%1$s) and a password. Leave that screen displayed.</string>
    <string name="home_tutorial_step_connect">Enter that SSID and password below, tap "Connect", then accept Android\'s connection request.</string>
    <string name="home_tutorial_note">The camera\'s network has no Internet access: the phone keeps using mobile data for everything else.</string>

    <!-- Sony A7R IV (ILCE-7RM4). The French labels were checked against a real camera on 2026-11-02;
         the English ones follow Sony's Help Guide and have not been checked on a camera set to English. -->
    <string name="tutorial_sony_a7r_iv_step_1">On the camera, press MENU, then open the Network tab (globe icon), page 1.</string>
    <string name="tutorial_sony_a7r_iv_step_2">Select "Send to Smartphone Func." then "Send to Smartphone".</string>
    <string name="tutorial_sony_a7r_iv_step_3">Choose "Select on Smartphone" to browse every image from the phone, or "Select on This Device" to send only a selection.</string>

    <!-- Runtime permissions -->
    <string name="permission_title">Permission required</string>
    <string name="permission_rationale_nearby">Android requires the "Nearby devices" permission to connect the app to the camera\'s Wi-Fi and talk to it on that local network. No location is collected.</string>
    <string name="permission_rationale_location">On this Android version, connecting to the camera\'s Wi-Fi goes through the location permission. The app neither stores nor sends your location.</string>
